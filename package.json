{
  "name": "slidex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run typecheck && npm test",
    "sample:title": "npm run build && node scripts/generate-sample.mjs",
    "sample:image": "npm run build && node scripts/generate-image-sample.mjs",
    "sample:gallery": "npm run build && node scripts/generate-image-gallery.mjs",
    "review:slide": "npm run build && node scripts/review-slide.mjs",
    "sample:visual-regression": "npm run build && node scripts/generate-visual-regression.mjs",
    "sample:two-column": "npm run build && node scripts/generate-two-column-sample.mjs",
    "sample:three-cards": "npm run build && node scripts/generate-three-cards-sample.mjs",
    "sample:comparison": "npm run build && node scripts/generate-comparison-sample.mjs",
    "sample:timeline": "npm run build && node scripts/generate-timeline-sample.mjs",
    "sample:process": "npm run build && node scripts/generate-process-sample.mjs",
    "sample:statistics": "npm run build && node scripts/generate-statistics-sample.mjs",
    "sample:chart": "npm run build && node scripts/generate-chart-sample.mjs",
    "review:regression": "npm run build && node scripts/review-visual-regression.mjs",
    "n8n:build": "node scripts/build-n8n-education-workflow.mjs",
    "n8n:import": "node scripts/import-n8n-staging.mjs",
    "n8n:executions": "node scripts/inspect-n8n-executions.mjs",
    "valtown:build": "npm run build && node scripts/build-valtown-project.mjs"
  },
  "dependencies": {
    "jszip": "3.10.2",
    "pptxgenjs": "3.12.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "7.0.2"
  }
}
